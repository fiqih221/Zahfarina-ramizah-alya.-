
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SecureClass</title>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: Arial, sans-serif;
      background: #101827;
      color: white;
      display: grid;
      place-items: center;
      min-height: 100vh;
      margin: 0;
      padding: 20px;
    }
    .card {
      width: 100%;
      max-width: 380px;
      background: #1e293b;
      padding: 28px;
      border-radius: 16px;
    }
    h1 { color: #60a5fa; text-align: center; }
    p { color: #cbd5e1; text-align: center; }
    input, button {
      width: 100%;
      padding: 12px;
      margin-top: 12px;
      border-radius: 8px;
      font-size: 15px;
    }
    input { border: 1px solid #475569; }
    button {
      border: 0;
      background: #2563eb;
      color: white;
      font-weight: bold;
    }
    button:active { background: #1d4ed8; }
    .switch {
      background: transparent;
      border: 1px solid #64748b;
    }
    #pesan { font-size: 13px; }
  </style>
</head>
<body>
  <main class="card">
    <h1>SecureClass</h1>
    <p id="judul">Login akun mahasiswa</p>

    <form id="form">
      <input id="nama" placeholder="Nama lengkap"
             autocomplete="name" hidden>
      <input id="email" type="email"
             placeholder="Email" required>
      <input id="password" type="password"
             placeholder="Password" minlength="8"
             autocomplete="current-password" required>
      <button id="kirim" type="submit">Login</button>
    </form>

    <button class="switch" id="ganti" type="button">
      Belum punya akun? Register
    </button>
    <p id="pesan" aria-live="polite"></p>
  </main>

  <script>
    const form = document.getElementById('form');
    const nama = document.getElementById('nama');
    const judul = document.getElementById('judul');
    const kirim = document.getElementById('kirim');
    const ganti = document.getElementById('ganti');
    const pesan = document.getElementById('pesan');
    let mode = 'login';

    ganti.onclick = () => {
      mode = mode === 'login' ? 'register' : 'login';
      nama.hidden = mode !== 'register';
      nama.required = mode === 'register';
      document.getElementById('password').autocomplete =
        mode === 'login' ? 'current-password' : 'new-password';
      judul.textContent = mode === 'login'
        ? 'Login akun mahasiswa' : 'Daftar akun mahasiswa';
      kirim.textContent = mode === 'login' ? 'Login' : 'Register';
      ganti.textContent = mode === 'login'
        ? 'Belum punya akun? Register' : 'Sudah punya akun? Login';
      pesan.textContent = '';
    };

    form.onsubmit = (e) => {
      e.preventDefault();
      pesan.textContent =
        'Tampilan berhasil diuji. Backend dan database belum terhubung.';
    };
  </script>
</body>
</html>
